# Server-side only. Never expose this to the browser.
ELEVENLABS_API_KEY=
# Filled in by `npm run create-agent` (or copy from the ElevenLabs dashboard).
ELEVENLABS_AGENT_ID=
# Optional: Kimmy's voice. Pick a Dutch voice in the ElevenLabs Voice Library and paste its id here.
KIMMY_VOICE_ID=
# Optional: LLM used by the agent.
KIMMY_LLM=claude-haiku-4-5
# Optional: conversation language (nl or en). Defaults to nl.
KIMMY_LANGUAGE=
